# Google OAuth 2.0 Configuration (Phase 5)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
# Create an OAuth 2.0 Client ID (Application type: Desktop app or Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Redirect URI
# Defaults to http://127.0.0.1:54321/callback if not specified.
# Ensure this matches the Authorized Redirect URI configured in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://127.0.0.1:54321/callback

# Token Encryption Key
# A secure 256-bit passphrase or random hex string used for AES-256-GCM authenticated
# encryption of OAuth tokens at rest in SQLite. Never share or commit this key.
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your-secure-32-byte-hex-or-passphrase-here
